{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herald.dev/schemas/herald-oss/security-posture.schema.json",
  "title": "Herald.OSS security posture record",
  "description": "Canonical record for a Herald.OSS security posture document. Captures the threat, the layered defenses, the analyzer rules, the threat-coverage matrix, and the residual. Prose lives in prose/herald-oss/explanation/security/; the record carries the structured facts that any render (index page, status badge, audit-trail handoff) reads from.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "first-affected-version",
    "mirrors",
    "threat",
    "layers",
    "analyzer-rules",
    "trust-boundary",
    "threat-coverage",
    "tests",
    "residual",
    "prose-slug",
    "last-reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier for the posture, used as the record file's base name."
    },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "posture-published-fix-pending-greenlight",
        "fix-in-implementation",
        "fix-shipped",
        "withdrawn"
      ]
    },
    "first-affected-version": {
      "type": "string",
      "description": "Earliest shipped Herald.OSS version that carries the issue."
    },
    "fix-target-version": {
      "type": "string",
      "description": "Planned Herald.OSS version to ship the fix."
    },
    "mirrors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other repos/packages that carry a byte-identical copy of the affected code."
    },
    "threat": {
      "type": "object",
      "required": ["summary", "mechanism"],
      "properties": {
        "summary": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "mechanism": {
          "type": "string",
          "contentMediaType": "text/markdown"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "closes", "does-not-close"],
        "properties": {
          "id": { "type": "string", "pattern": "^L[0-9]+$" },
          "name": { "type": "string" },
          "closes": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "does-not-close": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "honest-limit": {
            "type": "string",
            "contentMediaType": "text/markdown",
            "description": "Optional plainspoken note on what a reader must not over-read into this layer. Required for any layer described as defense-in-depth."
          }
        }
      }
    },
    "analyzer-rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "detects"],
        "properties": {
          "id": { "type": "string", "pattern": "^HERALD[0-9]{3,4}$" },
          "severity": {
            "type": "string",
            "enum": ["Error", "Warning", "Info"]
          },
          "detects": { "type": "string" },
          "cannot-detect": { "type": "string" }
        }
      }
    },
    "auditable-suppression": {
      "type": "object",
      "properties": {
        "attribute": { "type": "string" },
        "required-fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "build-output-shape": { "type": "string" }
      }
    },
    "trust-boundary": {
      "type": "object",
      "required": [
        "closed-by-construction",
        "closed-by-analyzer",
        "documented-residual",
        "out-of-scope"
      ],
      "properties": {
        "closed-by-construction": {
          "type": "array",
          "items": { "type": "string" }
        },
        "closed-by-analyzer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "documented-residual": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out-of-scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "threat-coverage": {
      "type": "array",
      "description": "One row per hostile-expert claim considered in the threat-model pass.",
      "items": {
        "type": "object",
        "required": ["claim", "status", "mechanism"],
        "properties": {
          "claim": { "type": "string", "pattern": "^[A-Z]$" },
          "summary": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "closed",
              "closed-defense-in-depth",
              "closed-documented-residual",
              "out-of-scope"
            ]
          },
          "mechanism": { "type": "string" },
          "test-ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "required": ["regression", "analyzer"],
      "properties": {
        "regression": {
          "type": "object",
          "required": ["id-range", "count", "summary"],
          "properties": {
            "id-range": { "type": "string" },
            "count": { "type": "integer" },
            "summary": { "type": "string" }
          }
        },
        "analyzer": {
          "type": "object",
          "required": ["id-range", "count", "summary"],
          "properties": {
            "id-range": { "type": "string" },
            "count": { "type": "integer" },
            "summary": { "type": "string" }
          }
        }
      }
    },
    "residual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary"],
        "properties": {
          "path": { "type": "string" },
          "summary": {
            "type": "string",
            "contentMediaType": "text/markdown"
          }
        }
      }
    },
    "prose-slug": {
      "type": "string",
      "description": "Slug of the prose page that is the human-readable form of this record."
    },
    "last-reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
